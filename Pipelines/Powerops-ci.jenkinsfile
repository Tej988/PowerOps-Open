pipeline {
    agent any
    environment {
        // Load credentials from Jenkins Credential Store
        SOURCE_APP_ID = credentials('SOURCE_APP_ID')
        SOURCE_CLIENT_SECRET = credentials('SOURCE_CLIENT_SECRET')
        SOURCE_TENANT_ID = credentials('SOURCE_TENANT_ID')
        SOLUTION_NAME = credentials('SOLUTION_NAME')
        EXPORT_PATH = 'C:\\solutions\\exported' 
        SOURCE_ENV_URL = credentials('SOURCE_ENV_URL')
        BRANCH_NAME = 'dev'
        GIT_CREDENTIALS = credentials('GITHUB')
        GIT_URL = "https://${GIT_CREDENTIALS}@github.com/Tej988/powerops2.git"
        PATH = "C:\\Users\\adminuser\\AppData\\Local\\Microsoft\\PowerAppsCLI\\;C:\\Program Files\\Git\\bin\\;$PATH"
    }
    stages {
        stage('Authenticate Source Environment') {
            steps {
                bat """
                pac auth create --applicationId %SOURCE_APP_ID% --clientSecret %SOURCE_CLIENT_SECRET% --tenant %SOURCE_TENANT_ID%
                """
            }
        }
        stage('Select Source Environment') {
            steps {
                bat """
                pac org select --environment https://%SOURCE_ENV_URL%
                """
            }
        }
        stage('Export Solution') {
            steps {
                bat """
                pac solution export --name ${SOLUTION_NAME} --path ${EXPORT_PATH} --managed --overwrite
                """
            }
        }
        stage('Unzip Exported Solution') {
            steps {
                echo "Attempting to unzip the solution..."
                bat """
                powershell -Command "if (Test-Path '${EXPORT_PATH}\\${SOLUTION_NAME}_managed.zip') { Expand-Archive -Path '${EXPORT_PATH}\\${SOLUTION_NAME}_managed.zip' -DestinationPath '${EXPORT_PATH}\\solutions\\${SOLUTION_NAME}' -Force } else { Write-Host 'Zip file not found at path: ${EXPORT_PATH}\\${SOLUTION_NAME}_managed.zip' }"
                """
            }
        }
        stage('Initialize Git, Ensure Remote, and Checkout Branch') {
            steps {
                dir("${EXPORT_PATH}\\solutions") {
                    script {
                        def isGitRepo = fileExists('.git')
                        if (!isGitRepo) {
                            echo "Initializing Git repository and adding remote 'origin'."
                            bat """
                            git init
                            git remote add origin ${GIT_URL}
                            """
                        } else {
                            def remoteExists = bat(script: "git remote", returnStdout: true).trim().contains("origin")
                            if (!remoteExists) {
                                echo "Remote 'origin' does not exist. Adding remote."
                                bat "git remote add origin ${GIT_URL}"
                            } else {
                                echo "Remote 'origin' already exists."
                            }
                        }
                        bat "git fetch origin && git checkout -B ${BRANCH_NAME}"
                    }
                }
            }
        }
        stage('Push Unzipped Solution to GitHub') {
            steps {
                dir("${EXPORT_PATH}\\solutions") {
                    script {
                        bat """
                        git fetch origin
                        git checkout ${BRANCH_NAME} || git checkout -b ${BRANCH_NAME}
                        git clean -fd
                        git pull origin ${BRANCH_NAME} --rebase
                        """
                        def changes = bat(script: "git status --porcelain", returnStdout: true).trim()
                        if (changes) {
                            bat """
                            git add .
                            git commit -m "Exported solution: ${SOLUTION_NAME}"
                            git push -u origin ${BRANCH_NAME}
                            """
                        } else {
                            echo "No changes to commit."
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                bat "powershell -Command \"Remove-Item -Path '${EXPORT_PATH}' -Recurse -Force\""
                echo "Pipeline completed."
            }
        }
    }
}
