pipeline {
    agent any
    environment {
        // Define variables
        EXPORT_DIRECTORY = 'C:\\CD\\Export'
        GIT_REPO_URL = 'https://github.com/Tej988/powerops2.git'  
        SOLUTION_NAME = credentials('SOLUTION_NAME')
        CLONE_PATH = "${EXPORT_DIRECTORY}\\solutions"
        ZIP_PATH = "${EXPORT_DIRECTORY}\\${SOLUTION_NAME}.zip"
        SOURCE_FOLDER = "${CLONE_PATH}\\${SOLUTION_NAME}"
        TARGET_APP_ID = credentials('TARGET_APP_ID')         // Load from Jenkins credentials
        TARGET_CLIENT_SECRET = credentials('TARGET_CLIENT_SECRET') // Load from Jenkins credentials
        TARGET_TENANT_ID = credentials('TARGET_TENANT_ID')   // Load from Jenkins credentials
        TARGET_ENV_URL = credentials('TARGET_ENV_URL')       // Load from Jenkins credentials
        PATH = "C:\\Users\\adminuser\\AppData\\Local\\Microsoft\\PowerAppsCLI\\;C:\\Program Files\\Git\\bin\\;$PATH"
        
    }
    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    // Step 1: Clear the export directory if it exists
                    if (fileExists(EXPORT_DIRECTORY)) {
                        bat "powershell -Command \"Remove-Item -Path '${EXPORT_DIRECTORY}\\*' -Recurse -Force\""
                        echo "Cleared previous contents in the export directory: ${EXPORT_DIRECTORY}"
                    }

                    // Step 2: Create the export directory
                    bat "powershell -Command \"New-Item -ItemType Directory -Path '${EXPORT_DIRECTORY}' -Force\""
                    echo "Export directory created at: ${EXPORT_DIRECTORY}"
                }
            }
        }
        stage('Clone Git Repository') {
            steps {
                script {
                    // Step 3: Clone the Git repository
                    if (!fileExists(CLONE_PATH)) {
                        bat "git clone ${GIT_REPO_URL} ${CLONE_PATH}"
                        echo "Repository cloned to: ${CLONE_PATH}"
                    } else {
                        echo "Repository already cloned at: ${CLONE_PATH}"
                    }
                }
            }
        }
        stage('Zip Dev Folder') {
            steps {
                script {
                    // Step 4: Create a zip file from the 'Dev' folder
                    if (fileExists(SOURCE_FOLDER)) {
                        bat "powershell -Command \"Compress-Archive -Path '${SOURCE_FOLDER}\\*' -DestinationPath '${ZIP_PATH}' -Force\""
                        echo "Zipped 'Dev' folder to: ${ZIP_PATH}"
                    } else {
                        echo "'Dev' folder not found in: ${CLONE_PATH}"
                    }
                }
            }
        }
        stage('Authenticate Target Environment') {
            steps {
                bat """
                pac auth create --applicationId %TARGET_APP_ID% --clientSecret %TARGET_CLIENT_SECRET% --tenant %TARGET_TENANT_ID%
                """
            }
        }
        stage('Select Target Environment') {
            steps {
                bat """
                pac org select --environment https://%TARGET_ENV_URL%
                """
            }
        }
        stage('Import Solution') {
            steps {
                bat """
                pac solution import --path ${ZIP_PATH} --async --overwrite
                """
            }
        }
    }
    post {
        always {
            script {
                // Clean up: Optional, but you can remove the export directory after use
                bat "powershell -Command \"Remove-Item -Path '${EXPORT_DIRECTORY}' -Recurse -Force\""
                echo "Pipeline completed."
            }
        }
    }
}
